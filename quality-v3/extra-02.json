[{"scene":"旅行观光","en":"Is there anything worth seeing nearby?","zh":"附近有什么值得看的吗？"},{"scene":"旅行观光","en":"What's the best time to visit?","zh":"什么时候去最好？"},{"scene":"旅行观光","en":"Do we need to book in advance?","zh":"我们需要提前预订吗？"},{"scene":"旅行观光","en":"How much is admission?","zh":"门票多少钱？"},{"scene":"旅行观光","en":"Is there a student discount?","zh":"有学生折扣吗？"},{"scene":"旅行观光","en":"What time does it close?","zh":"这里几点关门？"},{"scene":"旅行观光","en":"Can we take photos here?","zh":"这里可以拍照吗？"},{"scene":"旅行观光","en":"Is flash photography allowed?","zh":"可以开闪光灯拍照吗？"},{"scene":"旅行观光","en":"Where does the tour start?","zh":"参观从哪里开始？"},{"scene":"旅行观光","en":"How long is the guided tour?","zh":"导览大概多久？"},{"scene":"旅行观光","en":"Is there an English tour?","zh":"有英语导览吗？"},{"scene":"旅行观光","en":"Can we explore on our own?","zh":"我们可以自己逛吗？"},{"scene":"旅行观光","en":"Which trail would you recommend?","zh":"你推荐哪条步道？"},{"scene":"旅行观光","en":"Is the hike difficult?","zh":"这条徒步路线难吗？"},{"scene":"旅行观光","en":"Do we need hiking boots?","zh":"需要穿徒步鞋吗？"},{"scene":"旅行观光","en":"Is there drinking water along the way?","zh":"路上有饮用水吗？"},{"scene":"旅行观光","en":"Let's take a break here.","zh":"我们在这里休息一下吧。"},{"scene":"旅行观光","en":"The view is amazing.","zh":"风景太棒了。"},{"scene":"旅行观光","en":"Could you take a picture of us?","zh":"能帮我们拍张照吗？"},{"scene":"旅行观光","en":"One more, please!","zh":"麻烦再拍一张！"},{"scene":"海滩与户外","en":"Is it safe to swim here?","zh":"这里游泳安全吗？"},{"scene":"海滩与户外","en":"Are there lifeguards on duty?","zh":"这里有救生员值班吗？"},{"scene":"海滩与户外","en":"How strong is the current?","zh":"这里水流有多急？"},{"scene":"海滩与户外","en":"Is the water cold?","zh":"水冷吗？"},{"scene":"海滩与户外","en":"Let's stay close to shore.","zh":"我们待在靠岸的地方吧。"},{"scene":"海滩与户外","en":"I forgot my sunscreen.","zh":"我忘带防晒霜了。"},{"scene":"海滩与户外","en":"Do you have any sunscreen I can use?","zh":"你有防晒霜可以借我用吗？"},{"scene":"海滩与户外","en":"Let's find some shade.","zh":"我们找个阴凉的地方吧。"},{"scene":"海滩与户外","en":"Can we rent a paddleboard here?","zh":"这里可以租桨板吗？"},{"scene":"海滩与户外","en":"Do I need a life jacket?","zh":"我需要穿救生衣吗？"},{"scene":"海滩与户外","en":"I've never tried this before.","zh":"我以前没试过这个。"},{"scene":"海滩与户外","en":"Could you show me the basics?","zh":"你能教我基本动作吗？"},{"scene":"海滩与户外","en":"Let's take it slow.","zh":"我们慢慢来。"},{"scene":"海滩与户外","en":"I need a quick break.","zh":"我得稍微休息一下。"},{"scene":"海滩与户外","en":"Watch out for the rocks.","zh":"小心那些石头。"},{"scene":"海滩与户外","en":"The trail is slippery.","zh":"这条路很滑。"},{"scene":"海滩与户外","en":"My shoes are soaked.","zh":"我的鞋湿透了。"},{"scene":"海滩与户外","en":"I think we should head back.","zh":"我觉得我们该回去了。"},{"scene":"海滩与户外","en":"We made it!","zh":"我们成功了！"},{"scene":"海滩与户外","en":"That was totally worth it.","zh":"这一趟太值了。"},{"scene":"拍照与社交媒体","en":"Could you take a photo of me?","zh":"能帮我拍张照片吗？"},{"scene":"拍照与社交媒体","en":"Could you get the whole building in the shot?","zh":"能把整栋楼都拍进去吗？"},{"scene":"拍照与社交媒体","en":"Can you take one vertically?","zh":"可以竖着拍一张吗？"},{"scene":"拍照与社交媒体","en":"Let's try one from this angle.","zh":"我们从这个角度再拍一张吧。"},{"scene":"拍照与社交媒体","en":"Could you move back a little?","zh":"你能稍微往后退一点吗？"},{"scene":"拍照与社交媒体","en":"Make sure my feet are in the frame.","zh":"记得把我的脚也拍进去。"},{"scene":"拍照与社交媒体","en":"Wait, my eyes were closed.","zh":"等等，我刚才闭眼了。"},{"scene":"拍照与社交媒体","en":"This one looks great!","zh":"这张拍得真好！"},{"scene":"拍照与社交媒体","en":"Can you send me the photos?","zh":"你能把照片发给我吗？"},{"scene":"拍照与社交媒体","en":"I'll AirDrop them to you.","zh":"我用隔空投送发给你。"},{"scene":"拍照与社交媒体","en":"Could you tag me in that photo?","zh":"你能在那张照片里标记我吗？"},{"scene":"拍照与社交媒体","en":"Do you mind if I post this?","zh":"你介意我发这张照片吗？"},{"scene":"拍照与社交媒体","en":"I'd rather not be in the picture.","zh":"我不太想入镜。"},{"scene":"拍照与社交媒体","en":"Let's take a group photo.","zh":"我们拍张合照吧。"},{"scene":"拍照与社交媒体","en":"Can we get one without the flash?","zh":"可以不开闪光灯拍一张吗？"},{"scene":"拍照与社交媒体","en":"The lighting's better over here.","zh":"这边光线更好。"},{"scene":"拍照与社交媒体","en":"This looks better in person.","zh":"实物看着更好看。"},{"scene":"拍照与社交媒体","en":"The photo doesn't do it justice.","zh":"照片拍不出它真正的美。"},{"scene":"拍照与社交媒体","en":"I'll send you the link.","zh":"我把链接发给你。"},{"scene":"拍照与社交媒体","en":"I just posted it.","zh":"我刚发出去了。"},{"scene":"认识新朋友","en":"Mind if I join you?","zh":"我可以加入你们吗？"},{"scene":"认识新朋友","en":"Is anyone sitting here?","zh":"这里有人坐吗？"},{"scene":"认识新朋友","en":"I'm Alex, by the way.","zh":"对了，我叫亚历克斯。"},{"scene":"认识新朋友","en":"Nice to meet you, Alex.","zh":"很高兴认识你，亚历克斯。"},{"scene":"认识新朋友","en":"Where are you from?","zh":"你来自哪里？"},{"scene":"认识新朋友","en":"I'm from China.","zh":"我来自中国。"},{"scene":"认识新朋友","en":"How long have you been here?","zh":"你来这里多久了？"},{"scene":"认识新朋友","en":"Just a couple of days.","zh":"才两三天。"},{"scene":"认识新朋友","en":"What brought you here?","zh":"你怎么会来这里？"},{"scene":"认识新朋友","en":"I'm here for a short trip.","zh":"我是来短途旅行的。"},{"scene":"认识新朋友","en":"Do you live around here?","zh":"你住这附近吗？"},{"scene":"认识新朋友","en":"Yeah, just down the street.","zh":"对，就在这条街往前一点。"},{"scene":"认识新朋友","en":"What do you do for work?","zh":"你是做什么工作的？"},{"scene":"认识新朋友","en":"I work in design.","zh":"我是做设计的。"},{"scene":"认识新朋友","en":"How do you like it here so far?","zh":"你觉得这里怎么样？"},{"scene":"认识新朋友","en":"I'm really enjoying it.","zh":"我真的很喜欢这里。"},{"scene":"认识新朋友","en":"Do you use Instagram?","zh":"你用 Instagram 吗？"},{"scene":"认识新朋友","en":"Mind if I follow you?","zh":"我可以关注你吗？"},{"scene":"认识新朋友","en":"It was really nice talking to you.","zh":"跟你聊天很开心。"},{"scene":"认识新朋友","en":"Let's keep in touch.","zh":"我们保持联系。"},{"scene":"朋友聚会","en":"What time should I come over?","zh":"我几点过去比较好？"},{"scene":"朋友聚会","en":"Should I bring anything?","zh":"需要我带点什么吗？"},{"scene":"朋友聚会","en":"Just bring yourself!","zh":"人来就行！"},{"scene":"朋友聚会","en":"Make yourself comfortable.","zh":"别拘束，随意坐。"},{"scene":"朋友聚会","en":"Can I get you something to drink?","zh":"要不要喝点什么？"},{"scene":"朋友聚会","en":"I'll have whatever you're having.","zh":"你喝什么我就喝什么。"},{"scene":"朋友聚会","en":"Help yourself to some snacks.","zh":"零食随便吃。"},{"scene":"朋友聚会","en":"How do you two know each other?","zh":"你们俩怎么认识的？"},{"scene":"朋友聚会","en":"We met through a mutual friend.","zh":"我们通过共同的朋友认识的。"},{"scene":"朋友聚会","en":"Have you tried this dip?","zh":"你尝过这个蘸酱吗？"},{"scene":"朋友聚会","en":"This is so good!","zh":"这个真好吃！"},{"scene":"朋友聚会","en":"Want to play a game?","zh":"想玩个游戏吗？"},{"scene":"朋友聚会","en":"I'm terrible at this.","zh":"我特别不擅长这个。"},{"scene":"朋友聚会","en":"You're doing great!","zh":"你玩得很好！"},{"scene":"朋友聚会","en":"Whose turn is it?","zh":"轮到谁了？"},{"scene":"朋友聚会","en":"It's your turn.","zh":"轮到你了。"},{"scene":"朋友聚会","en":"I should probably get going.","zh":"我差不多该走了。"},{"scene":"朋友聚会","en":"Thanks for having me.","zh":"谢谢你邀请我来。"},{"scene":"朋友聚会","en":"Get home safe!","zh":"路上注意安全！"},{"scene":"朋友聚会","en":"Text me when you get home.","zh":"到家给我发个消息。"},{"scene":"安排时间","en":"Are you available tomorrow afternoon?","zh":"你明天下午有空吗？"},{"scene":"安排时间","en":"Let me check my calendar.","zh":"我看一下日程。"},{"scene":"安排时间","en":"I'm free after three.","zh":"我三点以后有空。"},{"scene":"安排时间","en":"Does Thursday work for you?","zh":"周四你方便吗？"},{"scene":"安排时间","en":"I have something scheduled then.","zh":"我那时候已经有安排了。"},{"scene":"安排时间","en":"Can we do Friday instead?","zh":"我们能改到周五吗？"},{"scene":"安排时间","en":"Anytime after lunch works.","zh":"午饭后任何时间都行。"},{"scene":"安排时间","en":"Let's make it five thirty.","zh":"那就定五点半吧。"},{"scene":"安排时间","en":"I'll send you the details.","zh":"我把详细信息发给你。"},{"scene":"安排时间","en":"Can we push it back half an hour?","zh":"能往后推半小时吗？"},{"scene":"安排时间","en":"Something came up.","zh":"临时有点事。"},{"scene":"安排时间","en":"Sorry for the short notice.","zh":"抱歉这么临时通知你。"},{"scene":"安排时间","en":"I need to reschedule.","zh":"我需要改一下时间。"},{"scene":"安排时间","en":"No problem. What works better?","zh":"没问题，什么时间更合适？"},{"scene":"安排时间","en":"Let's play it by ear.","zh":"我们到时候看情况再定。"},{"scene":"安排时间","en":"I'll let you know by tonight.","zh":"我今晚之前告诉你。"},{"scene":"安排时间","en":"Just a heads-up, I might be late.","zh":"提前说一声，我可能会迟到。"},{"scene":"安排时间","en":"I'm five minutes away.","zh":"我还有五分钟就到了。"},{"scene":"安排时间","en":"I'm here. Where are you?","zh":"我到了，你在哪里？"},{"scene":"安排时间","en":"See you in a bit.","zh":"待会儿见。"},{"scene":"手机与网络","en":"My phone's about to die.","zh":"我手机快没电了。"},{"scene":"手机与网络","en":"Do you have a charger I could borrow?","zh":"你有充电器能借我吗？"},{"scene":"手机与网络","en":"Is there an outlet nearby?","zh":"附近有插座吗？"},{"scene":"手机与网络","en":"I can't get a signal here.","zh":"这里没有信号。"},{"scene":"手机与网络","en":"The Wi-Fi keeps dropping.","zh":"无线网络老是断。"},{"scene":"手机与网络","en":"Could you share the Wi-Fi password?","zh":"能告诉我无线网络密码吗？"},{"scene":"手机与网络","en":"Can you send me your location?","zh":"能把你的位置发给我吗？"},{"scene":"手机与网络","en":"I'll share my live location.","zh":"我把实时位置分享给你。"},{"scene":"手机与网络","en":"I think I sent it to the wrong person.","zh":"我好像发错人了。"},{"scene":"手机与网络","en":"Sorry, that was meant for someone else.","zh":"抱歉，那条消息是发给别人的。"},{"scene":"手机与网络","en":"Did you get my message?","zh":"你收到我的消息了吗？"},{"scene":"手机与网络","en":"My battery's at one percent.","zh":"我手机只剩百分之一电了。"},{"scene":"手机与网络","en":"I need to update the app.","zh":"我得更新一下应用。"},{"scene":"手机与网络","en":"It's taking forever to load.","zh":"加载得也太慢了。"},{"scene":"手机与网络","en":"Could you scan this QR code?","zh":"你能扫一下这个二维码吗？"},{"scene":"手机与网络","en":"The link isn't working.","zh":"这个链接打不开。"},{"scene":"手机与网络","en":"Can you screenshot that for me?","zh":"你能帮我截个图吗？"},{"scene":"手机与网络","en":"Let's do a video call.","zh":"我们视频聊吧。"},{"scene":"手机与网络","en":"You're breaking up a little.","zh":"你的声音有点断断续续。"},{"scene":"手机与网络","en":"I think you're on mute.","zh":"你好像静音了。"},{"scene":"电话沟通","en":"Hi, is this a good time to talk?","zh":"你好，现在方便说话吗？"},{"scene":"电话沟通","en":"Sorry, I missed your call.","zh":"不好意思，我没接到你的电话。"},{"scene":"电话沟通","en":"I was in a meeting.","zh":"我刚才在开会。"},{"scene":"电话沟通","en":"Can I call you back in ten minutes?","zh":"我十分钟后回你电话可以吗？"},{"scene":"电话沟通","en":"I can barely hear you.","zh":"我几乎听不清你说话。"},{"scene":"电话沟通","en":"Could you speak up a little?","zh":"你能稍微大声一点吗？"},{"scene":"电话沟通","en":"There's a lot of background noise.","zh":"背景噪声很大。"},{"scene":"电话沟通","en":"Let me move somewhere quieter.","zh":"我换个安静点的地方。"},{"scene":"电话沟通","en":"Can you hear me now?","zh":"现在能听见了吗？"},{"scene":"电话沟通","en":"I think the call dropped.","zh":"电话好像断了。"},{"scene":"电话沟通","en":"I'll call you right back.","zh":"我马上给你回拨。"},{"scene":"电话沟通","en":"Who am I speaking with?","zh":"请问您是哪位？"},{"scene":"电话沟通","en":"May I ask who's calling?","zh":"请问哪位来电？"},{"scene":"电话沟通","en":"Could you hold for a moment?","zh":"请稍等一下好吗？"},{"scene":"电话沟通","en":"I'll put you through.","zh":"我帮您转接。"},{"scene":"电话沟通","en":"She's not available right now.","zh":"她现在不方便接电话。"},{"scene":"电话沟通","en":"Can I take a message?","zh":"需要我帮您留言吗？"},{"scene":"电话沟通","en":"Could you leave your number?","zh":"您能留下电话号码吗？"},{"scene":"电话沟通","en":"I'll have her call you back.","zh":"我会请她给您回电话。"},{"scene":"电话沟通","en":"Thanks for calling.","zh":"谢谢来电。"},{"scene":"工作日常","en":"Morning! How was your commute?","zh":"早上好！上班路上还顺利吗？"},{"scene":"工作日常","en":"I got stuck in traffic.","zh":"我堵车了。"},{"scene":"工作日常","en":"I have a lot on my plate today.","zh":"我今天事情特别多。"},{"scene":"工作日常","en":"Can we go over this together?","zh":"我们能一起过一下这个吗？"},{"scene":"工作日常","en":"Do you have a minute?","zh":"你现在有空吗？"},{"scene":"工作日常","en":"I'm in the middle of something.","zh":"我正在忙点事。"},{"scene":"工作日常","en":"Can I get back to you in a bit?","zh":"我一会儿回复你可以吗？"},{"scene":"工作日常","en":"I just sent you the file.","zh":"我刚把文件发给你了。"},{"scene":"工作日常","en":"Let me know if you have questions.","zh":"有问题随时告诉我。"},{"scene":"工作日常","en":"Could you take a quick look?","zh":"你能快速看一下吗？"},{"scene":"工作日常","en":"I think we're on the right track.","zh":"我觉得方向是对的。"},{"scene":"工作日常","en":"Let's keep it simple.","zh":"我们尽量简单点。"},{"scene":"工作日常","en":"That might take a little longer.","zh":"那个可能需要多一点时间。"},{"scene":"工作日常","en":"I'm almost done.","zh":"我快做完了。"},{"scene":"工作日常","en":"I need another day to finish it.","zh":"我还需要一天才能完成。"},{"scene":"工作日常","en":"Can we move the deadline?","zh":"我们能调整截止时间吗？"},{"scene":"工作日常","en":"Thanks for the quick turnaround.","zh":"谢谢你这么快就处理好了。"},{"scene":"工作日常","en":"Nice work on that!","zh":"那个做得不错！"},{"scene":"工作日常","en":"Let's wrap this up.","zh":"我们把这个收尾吧。"},{"scene":"工作日常","en":"I'm heading out. See you tomorrow.","zh":"我先下班了，明天见。"},{"scene":"会议讨论","en":"Shall we get started?","zh":"我们开始吧？"},{"scene":"会议讨论","en":"Can everyone see my screen?","zh":"大家能看到我的屏幕吗？"},{"scene":"会议讨论","en":"You're still on mute.","zh":"你还开着静音。"},{"scene":"会议讨论","en":"Let's start with a quick update.","zh":"我们先快速同步一下进展。"},{"scene":"会议讨论","en":"I'll keep this brief.","zh":"我简单说一下。"},{"scene":"会议讨论","en":"Could you walk us through it?","zh":"你能给大家讲一下吗？"},{"scene":"会议讨论","en":"Can you clarify that point?","zh":"你能解释一下那一点吗？"},{"scene":"会议讨论","en":"I have a quick question.","zh":"我有个小问题。"},{"scene":"会议讨论","en":"Sorry to interrupt.","zh":"抱歉打断一下。"},{"scene":"会议讨论","en":"Go ahead. I'm listening.","zh":"你说，我在听。"},{"scene":"会议讨论","en":"I agree with that approach.","zh":"我赞同这个方案。"},{"scene":"会议讨论","en":"I see it a little differently.","zh":"我的看法有点不同。"},{"scene":"会议讨论","en":"What do you think?","zh":"你怎么看？"},{"scene":"会议讨论","en":"Let's hear from everyone.","zh":"我们听听大家的意见。"},{"scene":"会议讨论","en":"We're running short on time.","zh":"我们时间不多了。"},{"scene":"会议讨论","en":"Can we take this offline?","zh":"我们会后单独讨论这个好吗？"},{"scene":"会议讨论","en":"Let's focus on the next steps.","zh":"我们重点讨论下一步吧。"},{"scene":"会议讨论","en":"Who's taking the lead on this?","zh":"这件事由谁牵头？"},{"scene":"会议讨论","en":"I'll follow up after the meeting.","zh":"我会在会后跟进。"},{"scene":"会议讨论","en":"Thanks, everyone. That's all for today.","zh":"谢谢大家，今天就到这里。"},{"scene":"邮件与消息","en":"Just checking in on this.","zh":"想跟进一下这件事。"},{"scene":"邮件与消息","en":"Did you have a chance to look at it?","zh":"你有时间看过了吗？"},{"scene":"邮件与消息","en":"Thanks for getting back to me.","zh":"谢谢你回复我。"},{"scene":"邮件与消息","en":"Sorry for the late reply.","zh":"抱歉回复晚了。"},{"scene":"邮件与消息","en":"I've attached the latest version.","zh":"我附上了最新版本。"},{"scene":"邮件与消息","en":"Please see the file attached.","zh":"请查看附件。"},{"scene":"邮件与消息","en":"Could you send it as a PDF?","zh":"可以发一份 PDF 吗？"},{"scene":"邮件与消息","en":"I can't open the attachment.","zh":"我打不开附件。"},{"scene":"邮件与消息","en":"Could you resend the link?","zh":"能再发一次链接吗？"},{"scene":"邮件与消息","en":"I've added my comments.","zh":"我已经加上了我的意见。"},{"scene":"邮件与消息","en":"Let me know what you think.","zh":"告诉我你的想法。"},{"scene":"邮件与消息","en":"I'll make those changes.","zh":"我会按这些意见修改。"},{"scene":"邮件与消息","en":"Here's the updated version.","zh":"这是更新后的版本。"},{"scene":"邮件与消息","en":"Just wanted to confirm the time.","zh":"想确认一下时间。"},{"scene":"邮件与消息","en":"Does that still work for you?","zh":"那个时间你还方便吗？"},{"scene":"邮件与消息","en":"Thanks for the reminder.","zh":"谢谢你提醒我。"},{"scene":"邮件与消息","en":"No action needed on your end.","zh":"你那边不需要做什么。"},{"scene":"邮件与消息","en":"I'll keep you posted.","zh":"有进展我会告诉你。"},{"scene":"邮件与消息","en":"Looking forward to hearing from you.","zh":"期待你的回复。"},{"scene":"邮件与消息","en":"Talk soon!","zh":"回头聊！"},{"scene":"学习英语","en":"How do you pronounce this word?","zh":"这个单词怎么发音？"},{"scene":"学习英语","en":"Could you give me an example?","zh":"你能举个例子吗？"},{"scene":"学习英语","en":"Is that a common expression?","zh":"这种说法常见吗？"},{"scene":"学习英语","en":"Does that sound natural?","zh":"这样说自然吗？"},{"scene":"学习英语","en":"Is there a more casual way to say it?","zh":"有没有更口语的说法？"},{"scene":"学习英语","en":"What's the difference between these two?","zh":"这两个有什么区别？"},{"scene":"学习英语","en":"Could you correct me if I'm wrong?","zh":"如果我说错了能纠正我吗？"},{"scene":"学习英语","en":"I'm trying to improve my pronunciation.","zh":"我在努力改善发音。"},{"scene":"学习英语","en":"I need more listening practice.","zh":"我需要多练听力。"},{"scene":"学习英语","en":"I understand more than I can say.","zh":"我听得懂的比会说的多。"},{"scene":"学习英语","en":"I know the word, but I can't remember it.","zh":"我认识这个词，但一时想不起来。"},{"scene":"学习英语","en":"Could you type that out for me?","zh":"你能把它打出来给我吗？"},{"scene":"学习英语","en":"Can we practice that one more time?","zh":"我们能再练一次吗？"},{"scene":"学习英语","en":"Let me try saying it.","zh":"让我试着说一下。"},{"scene":"学习英语","en":"Did I say that correctly?","zh":"我刚才说对了吗？"},{"scene":"学习英语","en":"I'm getting the hang of it.","zh":"我慢慢找到感觉了。"},{"scene":"学习英语","en":"I still get nervous speaking English.","zh":"我说英语还是会紧张。"},{"scene":"学习英语","en":"I'm learning a little every day.","zh":"我每天都在学一点。"},{"scene":"学习英语","en":"Thanks for being patient with me.","zh":"谢谢你耐心教我。"},{"scene":"学习英语","en":"That really helps.","zh":"这真的很有帮助。"},{"scene":"健身运动","en":"Do you work out regularly?","zh":"你经常锻炼吗？"},{"scene":"健身运动","en":"I'm trying to get back into shape.","zh":"我想恢复一下体能。"},{"scene":"健身运动","en":"I usually go to the gym after work.","zh":"我通常下班后去健身房。"},{"scene":"健身运动","en":"How often do you train?","zh":"你多久训练一次？"},{"scene":"健身运动","en":"I'm focusing on cardio today.","zh":"我今天主要练有氧。"},{"scene":"健身运动","en":"Could you spot me for a set?","zh":"你能帮我保护一组吗？"},{"scene":"健身运动","en":"Are you using this machine?","zh":"你在用这台器械吗？"},{"scene":"健身运动","en":"How many sets do you have left?","zh":"你还剩几组？"},{"scene":"健身运动","en":"Mind if I work in?","zh":"介意我们交替使用吗？"},{"scene":"健身运动","en":"I need to warm up first.","zh":"我得先热身。"},{"scene":"健身运动","en":"Let's stretch a little.","zh":"我们拉伸一下吧。"},{"scene":"健身运动","en":"My legs are so sore.","zh":"我腿酸得不行。"},{"scene":"健身运动","en":"I think I overdid it yesterday.","zh":"我昨天可能练过头了。"},{"scene":"健身运动","en":"Let's go for a run.","zh":"我们去跑步吧。"},{"scene":"健身运动","en":"What pace are you aiming for?","zh":"你打算跑什么配速？"},{"scene":"健身运动","en":"Let's take it easy today.","zh":"我们今天练轻松一点。"},{"scene":"健身运动","en":"I need to catch my breath.","zh":"我得喘口气。"},{"scene":"健身运动","en":"That was a tough workout.","zh":"这次训练真累。"},{"scene":"健身运动","en":"I'm glad I showed up.","zh":"还好我今天来了。"},{"scene":"健身运动","en":"See you at the gym!","zh":"健身房见！"},{"scene":"健康与药店","en":"I'm not feeling well.","zh":"我感觉不太舒服。"},{"scene":"健康与药店","en":"I think I'm coming down with something.","zh":"我好像要生病了。"},{"scene":"健康与药店","en":"I've had a headache all day.","zh":"我头疼一整天了。"},{"scene":"健康与药店","en":"My throat feels sore.","zh":"我嗓子有点疼。"},{"scene":"健康与药店","en":"I have a slight fever.","zh":"我有点低烧。"},{"scene":"健康与药店","en":"Do I need an appointment?","zh":"需要预约吗？"},{"scene":"健康与药店","en":"Is there a walk-in clinic nearby?","zh":"附近有不用预约的诊所吗？"},{"scene":"健康与药店","en":"I'd like to speak to a pharmacist.","zh":"我想咨询一下药剂师。"},{"scene":"健康与药店","en":"Do you have anything for a headache?","zh":"有治头疼的药吗？"},{"scene":"健康与药店","en":"Is this available over the counter?","zh":"这个不用处方能买到吗？"},{"scene":"健康与药店","en":"How often should I take this?","zh":"这个多久吃一次？"},{"scene":"健康与药店","en":"Should I take it with food?","zh":"这个需要随餐服用吗？"},{"scene":"健康与药店","en":"Are there any side effects?","zh":"有什么副作用吗？"},{"scene":"健康与药店","en":"I'm allergic to penicillin.","zh":"我对青霉素过敏。"},{"scene":"健康与药店","en":"I take medication every day.","zh":"我每天都要服药。"},{"scene":"健康与药店","en":"I need to refill my prescription.","zh":"我需要续配处方药。"},{"scene":"健康与药店","en":"I've been feeling dizzy.","zh":"我最近有点头晕。"},{"scene":"健康与药店","en":"I think I need some rest.","zh":"我觉得我需要休息。"},{"scene":"健康与药店","en":"I'm feeling a lot better today.","zh":"我今天感觉好多了。"},{"scene":"健康与药店","en":"Thanks for checking on me.","zh":"谢谢你关心我。"},{"scene":"理发与美容","en":"I'd like to get a haircut.","zh":"我想剪个头发。"},{"scene":"理发与美容","en":"Do you have any openings today?","zh":"今天还有空档吗？"},{"scene":"理发与美容","en":"Just a trim, please.","zh":"稍微修剪一下就好。"},{"scene":"理发与美容","en":"Not too short on the sides.","zh":"两边别剪太短。"},{"scene":"理发与美容","en":"Could you take a little off the top?","zh":"头顶稍微剪短一点可以吗？"},{"scene":"理发与美容","en":"I'd like to keep the length.","zh":"我想保留现在的长度。"},{"scene":"理发与美容","en":"Can you show me how much you'll cut?","zh":"你能比划一下要剪掉多少吗？"},{"scene":"理发与美容","en":"Something easy to style would be great.","zh":"最好是容易打理的发型。"},{"scene":"理发与美容","en":"Could you wash my hair first?","zh":"可以先帮我洗头吗？"},{"scene":"理发与美容","en":"A little shorter, please.","zh":"再短一点点。"},{"scene":"理发与美容","en":"That's perfect, thank you.","zh":"这样刚好，谢谢。"},{"scene":"理发与美容","en":"How much is a haircut here?","zh":"这里剪头发多少钱？"},{"scene":"理发与美容","en":"Do I need to book ahead?","zh":"我需要提前预约吗？"},{"scene":"理发与美容","en":"I'm looking for a nail salon.","zh":"我在找美甲店。"},{"scene":"理发与美容","en":"Do you have this color?","zh":"你们有这个颜色吗？"},{"scene":"理发与美容","en":"I'd like a natural look.","zh":"我想要自然一点的效果。"},{"scene":"理发与美容","en":"Could you make it a little lighter?","zh":"可以调浅一点吗？"},{"scene":"理发与美容","en":"How long will it take?","zh":"大概需要多久？"},{"scene":"理发与美容","en":"Can I pay by card?","zh":"我可以刷卡吗？"},{"scene":"理发与美容","en":"I'll book my next appointment later.","zh":"我下次再预约。"},{"scene":"银行与付款","en":"Is there an ATM nearby?","zh":"附近有自动取款机吗？"},{"scene":"银行与付款","en":"Can I withdraw cash here?","zh":"我可以在这里取现金吗？"},{"scene":"银行与付款","en":"Do you accept contactless payment?","zh":"可以感应支付吗？"},{"scene":"银行与付款","en":"My card isn't working.","zh":"我的卡刷不了。"},{"scene":"银行与付款","en":"Could I try another card?","zh":"我可以换张卡试试吗？"},{"scene":"银行与付款","en":"The payment didn't go through.","zh":"付款没有成功。"},{"scene":"银行与付款","en":"Could you try it again?","zh":"可以再试一次吗？"},{"scene":"银行与付款","en":"I think I've been charged twice.","zh":"我好像被重复扣款了。"},{"scene":"银行与付款","en":"Can you check the transaction?","zh":"能帮我查一下交易吗？"},{"scene":"银行与付款","en":"Is there an extra fee?","zh":"有额外手续费吗？"},{"scene":"银行与付款","en":"What's the exchange rate today?","zh":"今天的汇率是多少？"},{"scene":"银行与付款","en":"Can I exchange some cash?","zh":"我可以兑换一些现金吗？"},{"scene":"银行与付款","en":"Do you have smaller bills?","zh":"有小面额的纸币吗？"},{"scene":"银行与付款","en":"Could I get the receipt by email?","zh":"可以把收据发到邮箱吗？"},{"scene":"银行与付款","en":"I need to update my billing address.","zh":"我需要更新账单地址。"},{"scene":"银行与付款","en":"The total seems a little high.","zh":"总金额好像有点高。"},{"scene":"银行与付款","en":"Could you break down the charges?","zh":"能帮我列一下费用明细吗？"},{"scene":"银行与付款","en":"Can I pay in installments?","zh":"可以分期付款吗？"},{"scene":"银行与付款","en":"I'll pay the full amount today.","zh":"我今天一次付清。"},{"scene":"银行与付款","en":"Thanks for clearing that up.","zh":"谢谢你解释清楚。"},{"scene":"邮寄与快递","en":"I'd like to send this package.","zh":"我想寄这个包裹。"},{"scene":"邮寄与快递","en":"How much is shipping?","zh":"运费多少钱？"},{"scene":"邮寄与快递","en":"How long will delivery take?","zh":"送达需要多久？"},{"scene":"邮寄与快递","en":"Is tracking included?","zh":"包含物流追踪吗？"},{"scene":"邮寄与快递","en":"Could I get a tracking number?","zh":"可以给我运单号吗？"},{"scene":"邮寄与快递","en":"Do I need to fill out a customs form?","zh":"我需要填写海关申报单吗？"},{"scene":"邮寄与快递","en":"Is there a weight limit?","zh":"有重量限制吗？"},{"scene":"邮寄与快递","en":"Do you have a box that fits this?","zh":"有装得下这个的箱子吗？"},{"scene":"邮寄与快递","en":"Could you help me tape it up?","zh":"能帮我用胶带封好吗？"},{"scene":"邮寄与快递","en":"Is express shipping available?","zh":"可以加急寄送吗？"},{"scene":"邮寄与快递","en":"I'd like to return this package.","zh":"我想把这个包裹退回去。"},{"scene":"邮寄与快递","en":"Where can I drop this off?","zh":"我可以在哪里交寄？"},{"scene":"邮寄与快递","en":"Can I schedule a pickup?","zh":"可以预约上门取件吗？"},{"scene":"邮寄与快递","en":"My package says delivered, but it's not here.","zh":"物流显示已送达，但我没收到。"},{"scene":"邮寄与快递","en":"Could you check the delivery status?","zh":"能帮我查一下配送状态吗？"},{"scene":"邮寄与快递","en":"It was sent to the wrong address.","zh":"包裹送错地址了。"},{"scene":"邮寄与快递","en":"I need to change the delivery address.","zh":"我需要修改收货地址。"},{"scene":"邮寄与快递","en":"Can you leave it with the front desk?","zh":"可以放在前台吗？"},{"scene":"邮寄与快递","en":"Please don't leave it outside.","zh":"请不要放在门外。"},{"scene":"邮寄与快递","en":"Thanks for your help with this.","zh":"谢谢你帮我处理。"},{"scene":"日常问题与求助","en":"Excuse me, could you help me?","zh":"打扰一下，能帮我个忙吗？"},{"scene":"日常问题与求助","en":"I'm having trouble with this.","zh":"我弄这个有点困难。"},{"scene":"日常问题与求助","en":"I'm not sure what to do next.","zh":"我不确定下一步该怎么办。"},{"scene":"日常问题与求助","en":"Could you show me where to go?","zh":"你能告诉我该往哪儿走吗？"},{"scene":"日常问题与求助","en":"Is there someone I can ask?","zh":"有谁可以咨询吗？"},{"scene":"日常问题与求助","en":"Who should I speak to?","zh":"我应该找谁？"},{"scene":"日常问题与求助","en":"Could you write that down?","zh":"你能把它写下来吗？"},{"scene":"日常问题与求助","en":"I don't have my ID with me.","zh":"我没带身份证件。"},{"scene":"日常问题与求助","en":"I think there's been a mistake.","zh":"我觉得这里可能搞错了。"},{"scene":"日常问题与求助","en":"That's not what I was told.","zh":"之前不是这么跟我说的。"},{"scene":"日常问题与求助","en":"Could you double-check that?","zh":"你能再核实一下吗？"},{"scene":"日常问题与求助","en":"Is there another option?","zh":"还有别的选择吗？"},{"scene":"日常问题与求助","en":"What would you suggest?","zh":"你有什么建议？"},{"scene":"日常问题与求助","en":"That would be really helpful.","zh":"那就太有帮助了。"},{"scene":"日常问题与求助","en":"I can wait a few minutes.","zh":"我可以等几分钟。"},{"scene":"日常问题与求助","en":"Is there a faster way?","zh":"有没有更快的方法？"},{"scene":"日常问题与求助","en":"I'm sorry for the trouble.","zh":"不好意思给你添麻烦了。"},{"scene":"日常问题与求助","en":"No worries at all.","zh":"完全没关系。"},{"scene":"日常问题与求助","en":"I really appreciate your time.","zh":"非常感谢你抽出时间。"},{"scene":"日常问题与求助","en":"You saved me a lot of trouble.","zh":"你帮我省了不少麻烦。"}]