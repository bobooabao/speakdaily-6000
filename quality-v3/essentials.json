[
  {
    "id": 1,
    "en": "I'm good.",
    "zh": "我不用了／我挺好的（依语境）",
    "note": "可用于婉拒、表示自己没事，或回答近况。"
  },
  {
    "id": 2,
    "en": "My bad.",
    "zh": "我的错／不好意思",
