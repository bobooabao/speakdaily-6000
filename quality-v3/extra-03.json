[{"scene":"礼貌拒绝与边界","en":"Thanks, but I'll pass.","zh":"谢谢，不过我就不参加了。"},{"scene":"礼貌拒绝与边界","en":"I'm good for now, thanks.","zh":"我暂时不需要，谢谢。"},{"scene":"礼貌拒绝与边界","en":"Maybe some other time.","zh":"或许改天吧。"},{"scene":"礼貌拒绝与边界","en":"I don't think I can make it.","zh":"我恐怕去不了。"},{"scene":"礼貌拒绝与边界","en":"I already have plans.","zh":"我已经有安排了。"},{"scene":"礼貌拒绝与边界","en":"I'd rather stay in tonight.","zh":"我今晚更想待在家里。"},{"scene":"礼貌拒绝与边界","en":"That's not really my thing.","zh":"那不是我喜欢的类型。"},{"scene":"礼貌拒绝与边界","en":"I appreciate the offer, though.","zh":"不过还是谢谢你的好意。"},{"scene":"礼貌拒绝与边界","en":"Could we do something else?","zh":"我们能换个活动吗？"},{"scene":"礼貌拒绝与边界","en":"I need some time to think.","zh":"我需要一点时间考虑。"},{"scene":"礼貌拒绝与边界","en":"I'm not comfortable with that.","zh":"那样让我不太舒服。"},{"scene":"礼貌拒绝与边界","en":"I'd prefer not to talk about it.","zh":"我不太想谈这件事。"},{"scene":"礼貌拒绝与边界","en":"Can we change the subject?","zh":"我们能换个话题吗？"},{"scene":"礼貌拒绝与边界","en":"Please don't share that photo.","zh":"请不要分享那张照片。"},{"scene":"礼貌拒绝与边界","en":"I'd like to keep that private.","zh":"我想把这件事保留为隐私。"},{"scene":"礼貌拒绝与边界","en":"I need a little space right now.","zh":"我现在想自己待一会儿。"},{"scene":"礼貌拒绝与边界","en":"It's nothing personal.","zh":"不是针对你。"},{"scene":"礼貌拒绝与边界","en":"Thanks for understanding.","zh":"谢谢你的理解。"},{"scene":"礼貌拒绝与边界","en":"Let's agree to disagree.","zh":"我们保留不同意见吧。"},{"scene":"礼貌拒绝与边界","en":"No hard feelings.","zh":"别往心里去。"},{"scene":"生活服务与维修","en":"The sink is leaking.","zh":"水槽漏水了。"},{"scene":"生活服务与维修","en":"The toilet won't flush.","zh":"马桶冲不了水。"},{"scene":"生活服务与维修","en":"The power just went out.","zh":"刚刚停电了。"},{"scene":"生活服务与维修","en":"The lights keep flickering.","zh":"灯一直闪。"},{"scene":"生活服务与维修","en":"The door won't close properly.","zh":"门关不严。"},{"scene":"生活服务与维修","en":"Could someone come take a look?","zh":"能派人来看看吗？"},{"scene":"生活服务与维修","en":"How soon can you send someone?","zh":"最快什么时候能派人来？"},{"scene":"生活服务与维修","en":"Is there a service fee?","zh":"需要上门费吗？"},{"scene":"生活服务与维修","en":"Could you give me an estimate?","zh":"能给我估个价吗？"},{"scene":"生活服务与维修","en":"How long will the repair take?","zh":"维修大概要多久？"},{"scene":"生活服务与维修","en":"Do you need access to the apartment?","zh":"你需要进入公寓吗？"},{"scene":"生活服务与维修","en":"I'll be home after six.","zh":"我六点后在家。"},{"scene":"生活服务与维修","en":"Please call before you arrive.","zh":"到之前请打电话。"},{"scene":"生活服务与维修","en":"The problem seems to be fixed.","zh":"问题好像解决了。"},{"scene":"生活服务与维修","en":"It's still not working.","zh":"还是不能用。"},{"scene":"生活服务与维修","en":"Could you check it one more time?","zh":"你能再检查一次吗？"},{"scene":"生活服务与维修","en":"Is the repair covered by warranty?","zh":"维修在保修范围内吗？"},{"scene":"生活服务与维修","en":"Do I need to replace the whole thing?","zh":"我需要把整个东西换掉吗？"},{"scene":"生活服务与维修","en":"Thanks for coming so quickly.","zh":"谢谢你这么快赶来。"},{"scene":"生活服务与维修","en":"Everything's working now.","zh":"现在一切都正常了。"}]